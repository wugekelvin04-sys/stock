{
  "name": "stock-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Personal stock & options desktop app powered by Claude Code",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:electron && wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "postinstall": "electron-rebuild -f -w better-sqlite3,canvas"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "@types/better-sqlite3": "^7.6.13",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "canvas": "^3.2.3",
    "date-holidays": "^3.29.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.16.0",
    "node-cron": "^4.2.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "yahoo-finance2": "^3.14.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.2.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "wait-on": "^7.2.0"
  }
}
